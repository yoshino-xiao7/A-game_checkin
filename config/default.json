{
  "scheduler": {
    "cron": "0 */10 * * * *",
    "defaultHour": 9,
    "timezone": "Asia/Shanghai"
  },
  "retry": {
    "maxAttempts": 3,
    "baseDelayMs": 1200
  },
  "storage": {
    "attemptRetentionDays": 90
  },
  "communities": {
    "miyoushe": {
      "enabled": true,
      "requestTimeoutMs": 15000
    },
    "skland": {
      "enabled": true,
      "requestTimeoutMs": 15000
    },
    "kuro": {
      "enabled": true,
      "requestTimeoutMs": 15000
    }
  }
}
